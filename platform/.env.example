# Never put secrets in NUXT_PUBLIC_*.
NUXT_PUBLIC_LEGACY_URL=https://remyvnkhiemtruong.github.io/FIT.HCMUE-DOCUMENTS/

# Native PostgreSQL: fill locally, never commit credentials.
# postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/DATABASE
DATABASE_URL=
# Optional Nuxt runtime override; if set, takes precedence over DATABASE_URL.
NUXT_DATABASE_URL=

# Docker Compose: npm run env:init generates .env.docker with random credentials.
# Do not copy a localhost URL into Docker: the database hostname there is postgres.
COMPOSE_PROJECT_NAME=fit-hcmue-dev
APP_PORT=3001
POSTGRES_DB=fit_hcmue
POSTGRES_USER=fit_hcmue
POSTGRES_PASSWORD=

# Production Node server (npm start); production does not load .env automatically.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# Platform authentication and private uploads. Generate a random secret of at least 32 bytes.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
FILE_STORAGE_PATH=.data/uploads
SMTP_URL=
MAIL_FROM=
CLAMD_HOST=
CLAMD_PORT=3310
