{
  "name": "fit-hcmue-learning-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "dev:container": "nuxt dev --host 0.0.0.0 --port 3000",
    "env:init": "node scripts/dev-environment.mjs init",
    "dev:up": "node scripts/dev-environment.mjs up",
    "dev:down": "node scripts/dev-environment.mjs down",
    "dev:logs": "node scripts/dev-environment.mjs logs",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs",
    "test:postgres": "node scripts/verify-native-postgres.mjs",
    "test:docker": "node scripts/verify-docker.mjs",
    "postinstall": "nuxt prepare",
    "lint": "nuxt prepare && eslint . --max-warnings 0",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "typecheck": "nuxt typecheck && tsc --project tests/tsconfig.json",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1 --port 3000",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "content:check": "tsx scripts/import-content.ts",
    "content:import": "node --env-file-if-exists=.env --import tsx scripts/import-content.ts --apply",
    "admin:init": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:business": "node --import tsx scripts/verify-platform.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "local": "node --env-file-if-exists=.env --import tsx scripts/local-start.ts",
    "local:admin": "node --env-file-if-exists=.env --import tsx scripts/local-tools.ts admin",
    "local:worker": "node --env-file-if-exists=.env --import tsx scripts/local-tools.ts worker"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "better-auth": "1.7.12",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "markdown-it": "15.0.3",
    "mathjax-full": "3.2.1",
    "nodemailer": "10.2.0",
    "nuxt": "4.6.2",
    "pg": "8.23.1",
    "sanitize-html": "2.18.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
